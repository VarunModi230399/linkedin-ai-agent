# ── Langfuse (LLM tracing) ────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ── Search (Tavily) ───────────────────────────────
